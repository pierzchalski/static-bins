refresh_manifest() {
  local manifest="$TARGET_DIR/SHA256SUMS"
  local staged="$TARGET_DIR/.SHA256SUMS.new.$$"
  (
    cd "$TARGET_DIR"
    find bin -maxdepth 1 -type f -print0 | sort -z | xargs -0 sha256sum
  ) >"$staged"
  mv -f "$staged" "$manifest"
}

# Per-tool source pins for BUILDINFO. Release downloads and the Rust source
# are pinned inside their build functions above; Nix-built tools are pinned by
# the output store path, which the flake lock fully determines.
nix_tool_pins() {
  local host_system
  host_system="$("$RESOLVE_SYSTEM")"
  nix eval --raw --no-update-lock-file "$FLAKE_REF#packages.$host_system" \
    --apply "ps: builtins.concatStringsSep \"\" (map (tool: \"pin.\" + tool + \".nix_out=\" + ps.\"static-\${tool}-$TARGET_SYSTEM\".outPath + \"\\n\") [ \"bwrap\" \"fuse-overlayfs\" \"passt\" \"iptables\" \"iproute2\" \"nix\" \"caddy\" \"sops\" \"socat\" ])"
}

source_pins() {
  # Each build function declares its pin as `local` assignments; read them
  # back from this script so BUILDINFO cannot drift from what was fetched.
  awk -v target="$TARGET_SYSTEM" '
    /^build_[a-z_]+\(\) \{$/ { fn = $1; sub(/^build_/, "", fn); sub(/\(\)$/, "", fn); gsub(/_/, "-", fn); next }
    /^}$/ { fn = "" }
    fn != "" && /^  local (version|commit|lock_sha256)=/ {
      sub(/^  local /, ""); print "pin." fn "." $0
    }
    fn != "" && /remote add origin / { print "pin." fn ".repo=" $NF }
    fn != "" && $0 ~ "^    " target "\\) expected_sha256=" {
      line = $0; sub(/^.*expected_sha256=/, "", line); sub(/ ;;$/, "", line)
      print "pin." fn ".sha256=" line
    }
  ' "$SCRIPT_DIR/rebuild"
}

refresh_build_info() {
  local build_info="$TARGET_DIR/BUILDINFO"
  local staged="$TARGET_DIR/.BUILDINFO.new.$$"
  local link

  {
    printf 'format=2\n'
    printf 'target_system=%s\n' "$TARGET_SYSTEM"
    printf 'partial=%s\n' "$([[ $PARTIAL -eq 1 ]] && echo true || echo false)"
    printf 'repo_commit=%s\n' "$CAPTURED_REPO_COMMIT"
    printf 'repo_dirty=%s\n' "$CAPTURED_REPO_DIRTY"
    printf 'flake_nix_sha256=%s\n' "$CAPTURED_FLAKE_NIX_SHA256"
    printf 'flake_lock_sha256=%s\n' "$CAPTURED_FLAKE_LOCK_SHA256"
    printf 'rebuild_sha256=%s\n' "$CAPTURED_REBUILD_SHA256"
    source_pins
    nix_tool_pins
    while IFS= read -r link; do
      printf 'alias.%s=%s\n' "$link" "$(readlink "$BIN_DIR/$link")"
    done < <(find "$BIN_DIR" -mindepth 1 -maxdepth 1 -type l -printf '%f\n' | sort)
  } >"$staged"
  mv -f "$staged" "$build_info"
}

publish_full_bundle() {
  OLD_TARGET_DIR="$RECOVERY_TARGET_DIR"
  [[ ! -e "$OLD_TARGET_DIR" ]] || {
    printf 'rebuild: refusing to overwrite stale publication backup: %s\n' \
      "$OLD_TARGET_DIR" >&2
    return 1
  }

  if [[ -e "$FINAL_TARGET_DIR" ]]; then
    mv -- "$FINAL_TARGET_DIR" "$OLD_TARGET_DIR"
  else
    OLD_TARGET_DIR=
  fi
  if ! mv -- "$TARGET_DIR" "$FINAL_TARGET_DIR"; then
    if [[ -n "$OLD_TARGET_DIR" && -e "$OLD_TARGET_DIR" ]]; then
      mv -- "$OLD_TARGET_DIR" "$FINAL_TARGET_DIR"
      OLD_TARGET_DIR=
    fi
    return 1
  fi
  if [[ -n "$OLD_TARGET_DIR" ]]; then
    rm -rf -- "$OLD_TARGET_DIR"
    OLD_TARGET_DIR=
  fi
}

build_one() {
  local tool=$1
  printf '\n==> %s (%s)\n' "$tool" "$TARGET_SYSTEM"
  "build_${tool//-/_}"
}

start_worker() {
  local tool=$1

  (
    exec {LOCK_FD}>&-
    build_one "$tool"
  ) &
  LAST_WORKER_PID=$!
}

build_all() {
  local failed=0 running=0 tool

  printf 'rebuild: assembling artifacts with %d concurrent workers\n' \
    "$ARTIFACT_JOBS"
  for tool in "${ALL_TOOLS[@]}"; do
    start_worker "$tool"
    running=$((running + 1))
    if ((running >= ARTIFACT_JOBS)); then
      if ! wait -n; then
        failed=1
      fi
      running=$((running - 1))
    fi
  done
  while ((running > 0)); do
    if ! wait -n; then
      failed=1
    fi
    running=$((running - 1))
  done
  return "$failed"
}

build_single() {
  local status=0 worker_pid

  start_worker "$1"
  worker_pid=$LAST_WORKER_PID
  if ! wait "$worker_pid"; then
    status=1
  fi
  return "$status"
}

if [[ "$TOOL" == all ]]; then
  build_all
else
  build_single "$TOOL"
fi
set +m

assert_build_inputs_unchanged
refresh_build_info
refresh_manifest
if [[ $PARTIAL -ne 1 ]]; then
  "$SCRIPT_DIR/verify" --root "$STAGED_ROOT" --system "$TARGET_SYSTEM" --allow-cross
fi
assert_build_inputs_unchanged
publish_full_bundle
printf 'rebuild: published verified %s bundle\n' "$FINAL_TARGET_DIR"
