build_rclone() {
  local version=1.74.2
  local expected_sha256 url scratch archive candidate
  case "$TARGET_SYSTEM" in
    x86_64-linux) expected_sha256=72a806370072015ccbe4d81bcd348cc5eaf3beca6c65ba693fd43fb31fcca5b1 ;;
    aarch64-linux) expected_sha256=bc2b2eb8269b743ed7bcea869f3782cfb4931e41efa53fc8befc6dc8308b7a50 ;;
  esac
  url="https://downloads.rclone.org/v$version/rclone-v$version-linux-$RELEASE_ARCH.zip"
  scratch="$(new_scratch rclone)"
  archive="$scratch/rclone.zip"
  curl -fsSL -o "$archive" "$url"
  [[ "$(sha256sum "$archive" | awk '{print $1}')" == "$expected_sha256" ]] || {
    echo 'rebuild: rclone release sha256 mismatch' >&2
    return 1
  }
  unzip -q -j "$archive" "rclone-v$version-linux-$RELEASE_ARCH/rclone" -d "$scratch"
  candidate="$scratch/rclone"
  chmod u+w "$candidate"
  if [[ "$("$RESOLVE_SYSTEM")" == "$TARGET_SYSTEM" ]]; then
    "$candidate" version | grep -F "rclone v$version" >/dev/null
  fi
  install_binary "$candidate" rclone
}

